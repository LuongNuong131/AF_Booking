APP_ENV=development
# Copy the TiDB Cloud MySQL connection details. URL-encode the username and password.
# mysql+aiomysql://<user>:<password>@<host>:4000/booking_tracker?charset=utf8mb4
DATABASE_URL=
DATABASE_SSL=true
# Optional path to a CA certificate bundle; otherwise use the system trust store.
DATABASE_SSL_CA=
CORS_ORIGINS=["http://localhost:5173"]
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE_SECONDS=280
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_MS=5000
REQUEST_TIMEOUT_SECONDS=8
