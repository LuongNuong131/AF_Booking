APP_ENV=development
# Copy the TiDB Cloud MySQL connection details. URL-encode the username and password.
# mysql+aiomysql://<user>:<password>@<host>:4000/booking_tracker?charset=utf8mb4
DATABASE_URL=
# DATABASE_SSL remains supported; if both are supplied their values must agree.
DB_SSL=true
# Optional path to a CA certificate bundle; otherwise use the system trust store.
DATABASE_SSL_CA=
CORS_ORIGINS=["http://localhost:5173"]
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE_SECONDS=280
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_MS=5000
REQUEST_TIMEOUT_SECONDS=8
DB_LOCK_WAIT_TIMEOUT_SECONDS=5
# Required for auth. Use a random secret of at least 32 characters; never commit its value.
# JWT_SECRET is accepted as an alias; configure only one name.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720
JWT_ISSUER=booking-tracker
JWT_AUDIENCE=booking-tracker-web
AUTH_CACHE_TTL_SECONDS=12
AUTH_CACHE_MAX_ENTRIES=1000
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
AUTH_HASH_CONCURRENCY=2
MAX_REQUEST_BODY_BYTES=1048576
WS_MAX_MESSAGES_PER_SECOND=20
WS_SEND_TIMEOUT_SECONDS=5
# Seed credentials are supplied securely; never commit their real values.
ADMIN_USERNAME=
# 10–128 characters, different from username; first login must change it.
ADMIN_PASSWORD=
# Booking lookup/write budgets and process-local caches.
LOOKUP_TIMEOUT_SECONDS=6
NOTE_SAVE_TIMEOUT_SECONDS=12
EXPORT_TIMEOUT_SECONDS=55
KEY_INDEX_ENABLED=true
KEY_INDEX_BATCH_SIZE=1000
KEY_INDEX_RECONCILE_SECONDS=600
SNAPSHOT_CACHE_TTL_SECONDS=30
SNAPSHOT_CACHE_MAX_ENTRIES=2000
STALE_HOURS_DEFAULT=24
STATION_CODE_PATTERN=[A-Z]{3}
INVOICE_NUMBER_PATTERN=^[A-Z0-9][A-Z0-9\-_/.]{2,39}$
INVOICE_MAX_PER_BOOKING=20

# Folder/station search: dedicated DB deadline, per-user sliding-window rate limit.
SEARCH_DB_TIMEOUT_SECONDS=3
SEARCH_MAX_REQUESTS=120
SEARCH_RATE_WINDOW_SECONDS=60
SEARCH_RATE_MAX_ENTRIES=10000
STATION_CACHE_TTL_SECONDS=60

# Realtime remains single-instance/single-worker. Client responds to JSON ping with pong.
WS_PING_INTERVAL_SECONDS=25
WS_IDLE_TIMEOUT_SECONDS=60
WS_QUEUE_SIZE=128
WS_MAX_MESSAGE_BYTES=4096
LOCK_TTL_SECONDS=150
LOCK_SWEEP_INTERVAL_SECONDS=25
SCHEDULER_ENABLED=true
# Generate the current period on day 25 for work in the following month.
MONTHLY_BOOKING_ENABLED=true
MONTHLY_BOOKING_DAY=25
# Optional external trigger for Render Free; use the same secret in GitHub Actions.
MONTHLY_BOOKING_TOKEN=
SCHEDULER_JOB_TIMEOUT_SECONDS=120
STALE_JOB_INTERVAL_SECONDS=1200
STALE_JOB_BATCH_SIZE=100
TASK_JOB_INTERVAL_SECONDS=30

# Daily export Booking column; internal keys remain canonical.
EXPORT_BOOKING_KEY_STYLE=display

# Nightly snapshot integrity; reports only unless explicitly enabled.
INTEGRITY_RUN_TIME=02:00
INTEGRITY_AUTOFIX=false
INTEGRITY_TIMEOUT_SECONDS=600

# Operations and business-day reports (single backend instance)
APP_VERSION=0.2.0
DAILY_REPORT_TIME=18:30
NOTE_SEARCH_STRATEGY=like
SLOW_QUERY_THRESHOLD_MS=200
# Web Push stays disabled until all three values form a valid matching VAPID pair.
# Private key is raw base64url, generated locally; never put it in VITE_* or Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Prompt 10: optional telemetry and bounded data retention
SENTRY_DSN=
ERROR_ALERT_THRESHOLD=10
ERROR_ALERT_WINDOW_SECONDS=60
ERROR_ALERT_COOLDOWN_SECONDS=60
RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=60
TASK_RETENTION_DAYS=90
RETENTION_INTERVAL_SECONDS=86400
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES=100
# Private note images (Cloudflare R2 / S3). Set all four fields together to enable.
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=af-booking-notes
# S3_REGION=auto
# S3_ACCESS_KEY_ID=store-in-your-secret-manager
# S3_SECRET_ACCESS_KEY=store-in-your-secret-manager

# Optional Google Cloud Translation v2 for the ticket Vietnamese → English helper.
# Leave empty to use the explicit Google Translate link + review/paste flow.
GOOGLE_TRANSLATE_API_KEY=
