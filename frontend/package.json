{
  "name": "booking-tracker-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "configure:csp": "node scripts/configure-csp.mjs",
    "test:security": "node scripts/check-security.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@vueuse/core": "13.9.0",
    "axios": "1.21.0",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "element-plus": "2.14.7",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "js-beautify": "2.0.3",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
