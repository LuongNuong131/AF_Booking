# Public configuration only. Never put credentials in VITE_* variables.
VITE_API_URL=http://localhost:8000/api/v1
# Optional: derived from VITE_API_URL when blank. Production requires wss://.
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_TIMEOUT_SCALE=1
# VITE_API_BASE_URL is accepted as a legacy fallback when VITE_API_URL is unset.

# Optional public project DSN; include the same value when running configure:csp.
VITE_SENTRY_DSN=
